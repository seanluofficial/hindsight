# Copy to .env and fill in. .env is gitignored.

# SEC requires a descriptive User-Agent with real contact info on every request.
# Requests without one are throttled and eventually blocked.
HINDSIGHT_EDGAR_CONTACT=seanlu727@gmail.com

# Tiingo API key — https://www.tiingo.com/account/api/token
# Chosen over yfinance because it retains delisted tickers (invariant 2).
TIINGO_API_KEY=

# Google Gemini — free tier, no credit card: https://aistudio.google.com/apikey
# Default scoring provider.
GEMINI_API_KEY=

# Optional: only needed for --provider anthropic
ANTHROPIC_API_KEY=
